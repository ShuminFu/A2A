        "note": "Both states resume the same task_id once the client responds."
      },
      {
        "id": "terminal",
        "label": "Terminal exits",
        "focus": [
          "working",
          "failed",
          "canceled",
          "rejected"
        ],
        "note": "Four terminal states; SubscribeToTask is refused once any of them is reached."
