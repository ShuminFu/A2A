  "cards": [
    {
      "dot": "emerald",
      "title": "Main rail",
      "items": [
        "A task is created by the server on SendMessage",
        "SUBMITTED and WORKING are the only non-terminal rail states",
        "COMPLETED carries the Artifacts the client asked for"
      ]
    },
    {
      "dot": "amber",
      "title": "Interrupted states",
      "items": [
        "INPUT_REQUIRED and AUTH_REQUIRED pause without ending the task",
        "The client resumes with the same task_id and context_id",
        "Streaming marks these as final chunks, not as an end of task"
      ]
    },
    {
      "dot": "rose",
      "title": "Terminal exits",
      "items": [
        "COMPLETED, FAILED, CANCELED and REJECTED are terminal",
        "SubscribeToTask returns UnsupportedOperationError once terminal",
        "REJECTED can happen at creation, before any work starts"
      ]
    }
