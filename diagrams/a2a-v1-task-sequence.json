    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Discovery first",
      "items": [
        "The Agent Card is fetched before any task exists",
        "supported_interfaces picks binding and protocol_version",
        "JWS signatures let a client trust a card across org boundaries"
      ]
    },
    {
      "dot": "emerald",
      "title": "Message-centric core",
      "items": [
        "SendMessage replaces v0.1 tasks/send",
        "A task is created by the server, not named by the client",
        "input_required and auth_required are interrupted, not terminal"
      ]
    },
    {
      "dot": "violet",
      "title": "Result delivery",
      "items": [
        "Stream: SendStreamingMessage or SubscribeToTask",
        "Push: TaskPushNotificationConfig webhook",
        "Poll: GetTask and ListTasks"
      ]
    }
  ]
