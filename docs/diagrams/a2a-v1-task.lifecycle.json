  "cards": [
    {
      "dot": "emerald",
      "title": "Forward path",
      "items": [
        "SendMessage returns either a stateless Message or a stateful Task",
        "Submitted to Working to Completed is the only forward progression"
      ]
    },
    {
      "dot": "amber",
      "title": "Interrupted states",
      "items": [
        "Auth Required and Input Required pause a task without ending it",
        "The client resumes by sending a message carrying the same taskId"
      ]
    },
    {
      "dot": "rose",
      "title": "Terminal states",
      "items": [
        "Completed, Canceled, Rejected and Failed are terminal and immutable",
        "New in v1.0: TASK_STATE_ prefix, plus REJECTED and AUTH_REQUIRED"
      ]
    }
  ]
